# EchoWeb environment.
#
# NOTE: this app does not read a .env file itself — there is no dotenv. Docker
# Compose reads this file to substitute ${VAR} in docker-compose.yml, and only
# the variables that file forwards reach the process. Running `npm run dev`
# directly, export these into the shell instead.
#
# Everything else about this app is a row in `echo_tbl_Settings` in the Echo
# database (`sApp` = '*' for every Echo app, or 'web' for this one), defined in
# EchoDatabase `init/009_settings.sql`.

# ── Process ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3160
LOG_LEVEL=info

# ── The Echo database (required) ─────────────────────────────────────────────
# Where echo_tbl_Settings lives. A database cannot carry its own address, so
# these stay here. No defaults: a wrong host that looks configured is worse
# than one that is plainly missing.
DB_HOST=echo-database
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=
DB_NAME=echo_db

# ── IdentityBase, via NocoDB (required) ──────────────────────────────────────
# PARENT_DOMAIN and IDENTITY_CLIENT_SECRET are the platform's, not this app's,
# so they are read from the IdentityBase NocoDB base rather than restated here.
# Without them the app exits at startup.
#
# On a single-host install these come from identity's bootstrap file, mounted
# read-only at /data/config.json — leave both blank and it is picked up.
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Where that bootstrap file lives, if not /data/config.json.
# ECHO_CONFIG_DIR=/data
# ECHO_CONFIG_PATH=/data/config.json

# ── Optional: pin a setting here ─────────────────────────────────────────────
# Any of these keys may be set in the environment, where it OVERRIDES the
# echo_tbl_Settings row. For deployments that manage configuration as
# environment rather than as rows; blank counts as unset.
#
# A stale value here silently wins over a correct row, so pin nothing you are
# not deliberately overriding.
#
# ECHO_SERVICE_BASE_URL=   # internal, container-to-container; not derived
# MEDIA_BASE_URL=          # derived: https://media-echo.<PARENT_DOMAIN>
# APP_BASE_URL=            # derived: https://echo.<PARENT_DOMAIN>
# IDENTITY_BASE_URL=       # derived: https://identity.<PARENT_DOMAIN>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=
# UISP_BASE_URL=           # CRM lookups: <UISP_BASE_URL>/crm/api/v1.0/clients
# UISP_CRM_APP_KEY_READ=
# UISP_SSO_SECRET=
# UISP_PLUGIN_URL=
#
# Real-time updates. Only the public half — the app id and secret belong to
# EchoService, which publishes the events and signs channel authorizations.
# Leave both unset and the browser falls back to polling every 30 seconds.
# PUSHER_KEY=
# PUSHER_CLUSTER=
