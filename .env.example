# Export these values into the process environment, or forward them through Docker Compose.
# EchoWeb does not load .env itself.
NODE_ENV=development
PORT=3160
LOG_LEVEL=info

# NocoDB coordinates for PlatformConfig, the only runtime settings source.
# Whitelabel and business values live in cfg_tbl_Setting rows, not in this file.
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Internal service addresses. Defaults match the standard Compose stack; set
# these only where the service names differ, as in a preview environment.
# ECHO_SERVICE_BASE_URL=http://echo-service:8080
# MEDIA_INTERNAL_BASE_URL=http://echo-media:8082


# DB_HOST/PORT/NAME/USER/PASSWORD are PlatformConfig rows, never environment pins.
# Missing DB_HOST derives lsdb.<PARENT_DOMAIN>. Restart after pool coordinate edits.

# compose.yaml uses a service-specific token in multi-repo environments.
ECHO_WEB_NOCODB_API_TOKEN=
ECHO_NETWORK=echo-net
ECHO_PROXY_NETWORK=npm_network
# ECHO_WEB_REVISION=
# ECHO_WEB_EPOCH=
# ECHO_WEB_DIRTY=false
