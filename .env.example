NODE_ENV=development
PORT=3160
LOG_LEVEL=info

# Canonical default. Use legacy explicitly only during a coordinated rollout;
# that still requires Identity v2 for central sessions.
SETTINGS_MODE=platform
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Echo mapping database bootstrap remains explicit in this foundation release.
DB_HOST=echo-database
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=
DB_NAME=echo_db

# Nonblank overrides of PlatformConfig echo-web -> echo -> * settings.
# PARENT_DOMAIN=
# IDENTITY_BASE_URL=
# IDENTITY_CLIENT_SECRET=
# ECHO_SERVICE_BASE_URL=
# MEDIA_BASE_URL=
# APP_BASE_URL=
# PUSHER_KEY=
# PUSHER_CLUSTER=
