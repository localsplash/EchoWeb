# Export these values into the process environment, or forward them through Docker Compose.
# EchoWeb does not load .env itself.
NODE_ENV=development
PORT=3160
LOG_LEVEL=info

# PlatformConfig is the only runtime settings source.
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Internal service addresses. Defaults match the standard Compose stack; set
# these only where the service names differ, as in a preview environment.
# ECHO_SERVICE_BASE_URL=http://echo-service:8080
# MEDIA_INTERNAL_BASE_URL=http://echo-media:8082

# Echo application database bootstrap remains explicit.
DB_HOST=echo-database
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=
DB_NAME=echo_db

# Nonblank overrides of PlatformConfig echo-web -> echo -> * settings.
# PARENT_DOMAIN=
# IDENTITY_BASE_URL=
# IDENTITY_PUBLIC_BASE_URL=
# IDENTITY_CLIENT_SECRET=
# APP_BASE_URL=
# PUSHER_KEY=
# PUSHER_CLUSTER=
