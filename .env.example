# EchoWeb reads its settings from NocoDB, not from this file: the base
# `IdentityBase` (one base per repository, named `{Repo}Base`), table
# `auth_tbl_Settings`. See localsplash/identify#15 for the standard.
#
# The base is found by NAME at runtime, never by a base ID in a file: a
# pasted ID survives a rename and outlives a restore. The name is expected to
# be unique — NocoDB does not enforce that, we do.
#
# If the base cannot be found, this app retries once at startup and then
# exits saying so. There is no fallback to defaults.

NODE_ENV=development
PORT=3160
LOG_LEVEL=info

# ── The settings store (NocoDB at nocodb.X.TLD) ──────────────────────────────
# Generate the API token in the NocoDB UI: Account → Tokens.
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=generate-in-nocodb-ui

# ── Optional: pin a setting here ─────────────────────────────────────────────
# Any key below may also be set in this file, where it OVERRIDES the stored
# row. That is an override for deployments that manage configuration as
# environment, not a default; blank counts as unset. The rows themselves live
# in IdentityBase.auth_tbl_Settings and are shared with every other app.
#
# The trusted network — ONE value for the whole platform, the `trustedCIDR`
# row. Not a per-app spelling of the same network.
# IDENTITY_TRUSTED_NETWORK=10.9.0.0/16
#
# ECHO_SERVICE_BASE_URL=
# MEDIA_BASE_URL=
# APP_BASE_URL=
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=
# UISP_BASE_URL=
# UISP_CRM_APP_KEY_READ=
# UISP_SSO_SECRET=
# UISP_PLUGIN_URL=
