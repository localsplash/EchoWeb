NODE_ENV=development
PORT=3160
LOG_LEVEL=info
ECHO_SERVICE_BASE_URL=https://io.echo.wisp.net

# Database (EchoWeb reads auth tables directly)
DB_HOST=echo-database
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=
DB_NAME=echo_db

# Google OAuth
# Authorized redirect URI: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# UISP integration
UISP_BASE_URL=https://my.wisp.net
UISP_CRM_APP_KEY_READ=
# UISP_SSO_SECRET must match the ssoSecret field in the UISP plugin config
# Generate with: openssl rand -hex 32
UISP_SSO_SECRET=
# "Plugin public URL" shown on the UISP plugin page after install.
# UCRM generates this; leave blank to hide the ISP button on the login page.
UISP_PLUGIN_URL=

# Public URL of this app (must match OAuth redirect URI registered in Google Cloud Console)
APP_BASE_URL=https://dev-echo.localsplash.ai
