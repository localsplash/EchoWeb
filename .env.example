# EchoWeb reads its settings from the Echo database — table
# `echo_tbl_Settings`, rows where `sApp` is '*' (every Echo app) or 'web'
# (this one). See EchoDatabase `init/009_settings.sql`.
#
# This file carries only what cannot describe itself: how to reach that
# database. There is nothing else — this app reads nothing from NocoDB, so a
# deployment needs no NocoDB credentials to run it.

NODE_ENV=development
PORT=3160
LOG_LEVEL=info

# ── The Echo database ────────────────────────────────────────────────────────
# Where echo_tbl_Settings lives. A database cannot carry its own address, so
# these stay here. No defaults: a wrong host that looks configured is worse
# than one that is plainly missing.
DB_HOST=echo-database
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=
DB_NAME=echo_db

# ── Optional: pin a setting here ─────────────────────────────────────────────
# Any echo_tbl_Settings key may also be set here, where it OVERRIDES the row.
# An override for deployments that manage configuration as environment, not a
# default; blank counts as unset.
#
# ECHO_SERVICE_BASE_URL=
# MEDIA_BASE_URL=
# APP_BASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=
# UISP_BASE_URL=
# UISP_CRM_APP_KEY_READ=
# UISP_SSO_SECRET=
# UISP_PLUGIN_URL=
#
# Real-time updates. Only the public half — the app id and secret belong to
# EchoService, which publishes the events and signs channel authorizations.
# Leave both unset and the browser falls back to polling every 30 seconds.
# PUSHER_KEY=
# PUSHER_CLUSTER=
