# Copy to .env next to this environment's compose.yaml.
ECHO_NETWORK=echo-net
ECHO_PROXY_NETWORK=npm_network
ECHO_MEDIA_VOLUME=echo-media-data
ECHO_SERVICE_LOGS_VOLUME=echo-service-logs
NOCODB_BASE_URL=http://nocodb:8080
ECHO_WEB_NOCODB_API_TOKEN=
ECHO_SERVICE_NOCODB_API_TOKEN=

# Operator-only migration/account jobs; never store MySQL admin credentials in PlatformConfig.
ECHO_DB_NETWORK=echo-net
ECHO_DB_HOST=lsdb.X.TLD
ECHO_DB_NAME=echo_db
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
ECHO_WEB_DB_USER=echo_web
ECHO_WEB_DB_PASSWORD=
ECHO_SERVICE_DB_USER=echo_service
ECHO_SERVICE_DB_PASSWORD=
ECHO_DB_ACCESS=read-write

# Supply each repository's OWN Git revision and commit epoch. No shared stamp.
ECHO_WEB_REVISION=
ECHO_WEB_EPOCH=
ECHO_WEB_DIRTY=false
ECHO_SERVICE_REVISION=
ECHO_SERVICE_EPOCH=
ECHO_SERVICE_DIRTY=false
ECHO_MEDIA_REVISION=
ECHO_MEDIA_EPOCH=
ECHO_MEDIA_DIRTY=false
