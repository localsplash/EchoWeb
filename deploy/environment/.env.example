# Copy to .env (mode 600) next to compose.yaml. Only bootstrap and Docker
# wiring belong here: every application setting is a PlatformConfig row
# (cfg_tbl_Setting, scopes * < echo < echo-web / echo-service). Values that
# equal the compose defaults are deliberately not repeated.

# Where the settings store is, and one NocoDB token per application.
NOCODB_BASE_URL=https://nocodb.X.TLD
ECHO_WEB_NOCODB_API_TOKEN=
ECHO_SERVICE_NOCODB_API_TOKEN=

# Docker objects this host already has.
ECHO_NETWORK=echo-local
ECHO_MEDIA_VOLUME=echo-media-data
ECHO_SERVICE_LOGS_VOLUME=echo-service-logs
# ECHO_PROXY_NETWORK=npm_network

# AidaPlatformDB/echo's migration/account jobs, which run on ECHO_NETWORK at
# every deploy. They run as echo_admin — created by AidaPlatformDB/install.sh
# database with all rights on echo_db and CREATE USER, nothing else — never
# as the MySQL root, which stays on the database host. These four values are
# the echo/MYSQL_ADMIN_PASSWORD, echo-web/DB_PASSWORD and
# echo-service/DB_PASSWORD rows; ECHO_DB_HOST is the host the echo/DB_HOST
# row names (or lsdb.X.TLD). AidaPlatformDB/install.sh apps writes them.
ECHO_DB_HOST=lsdb.X.TLD
MYSQL_ADMIN_USER=echo_admin
MYSQL_ADMIN_PASSWORD=
ECHO_WEB_DB_PASSWORD=
ECHO_SERVICE_DB_PASSWORD=
# ECHO_DB_NAME=echo_db  ECHO_WEB_DB_USER=echo_web  ECHO_SERVICE_DB_USER=echo_service
# ECHO_DB_ACCESS=read-write

# Image tags follow each checkout's commit; deploy.sh exports the *_SHORT stamps
# (and *_REVISION/EPOCH/DIRTY, which each repo's compose.yaml reads).
ECHO_WEB_TAG=dev-${ECHO_WEB_SHORT:-${BUILD_REVISION_SHORT-local}}
ECHO_SERVICE_TAG=dev-${ECHO_SERVICE_SHORT:-${BUILD_REVISION_SHORT-local}}
ECHO_MEDIA_TAG=dev-${ECHO_MEDIA_SHORT:-${BUILD_REVISION_SHORT-local}}
